---
layout: null
---
{% assign published_weekly = site.weekly | where_exp: "item", "item.published != false" %}
{% assign published_moments = site.moments | where_exp: "item", "item.published != false" %}
{% assign search_items = site.posts | concat: published_weekly | concat: published_moments %}
[
  {% for item in search_items %}
  {
    "title": {{ item.title | jsonify }},
    "url": "{{ item.url }}",
    "date": "{{ item.date | date: '%Y-%m-%d' }}",
    "categories": {% if item.collection == "weekly" or item.collection == "moments" %}[]{% elsif item.categories %}{{ item.categories | jsonify }}{% else %}[]{% endif %},
    "tags": {% if item.collection == "weekly" or item.collection == "moments" %}[]{% elsif item.tags %}{{ item.tags | jsonify }}{% else %}[]{% endif %},
    "summary": {{ item.summary | default: item.description | default: item.excerpt | default: "" | strip_html | normalize_whitespace | jsonify }},
    "content": {{ item.content | strip_html | jsonify }},
    "type": "{% if item.collection == 'weekly' %}weekly{% elsif item.collection == 'moments' %}moment{% else %}post{% endif %}",
    "lang": "zh-CN"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
