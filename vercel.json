{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "_site",
  "build": {
    "env": {
      "LANG": "en_US.UTF-8",
      "RUBYOPT": "-E utf-8"
    }
  },
  "rewrites": [
    {
      "source": "/photos",
      "destination": "https://photos.byhaoran.cn/photos/"
    },
    {
      "source": "/photos/",
      "destination": "https://photos.byhaoran.cn/photos/"
    },
    {
      "source": "/photos/all",
      "destination": "https://photos.byhaoran.cn/photos/all"
    },
    {
      "source": "/photos/all/",
      "destination": "https://photos.byhaoran.cn/photos/all/"
    },
    {
      "source": "/photos/albums/:slug",
      "destination": "https://photos.byhaoran.cn/photos/albums/:slug"
    },
    {
      "source": "/photos/albums/:slug/",
      "destination": "https://photos.byhaoran.cn/photos/albums/:slug/"
    },
    {
      "source": "/photos/photo/:id",
      "destination": "https://photos.byhaoran.cn/photos/photo/:id"
    },
    {
      "source": "/photos/photo/:id/",
      "destination": "https://photos.byhaoran.cn/photos/photo/:id/"
    },
    {
      "source": "/photos/sitemap.xml",
      "destination": "https://photos.byhaoran.cn/photos/sitemap.xml"
    },
    {
      "source": "/photos/:path*",
      "destination": "https://photos.byhaoran.cn/photos/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|files)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
